="1" value="59"/><column index="2" value="195"/><column index="3" value="67"/><column index="5" value="63"/><column index="6" value="241"/><column index="7" value="98"/><column index="8" value="85"/><column index="9" value="72"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 5">SELECT
 InvoiceDate,
 BillingAddress,
 BillingCity,
 total,
 CASE
 WHEN total &lt; 2.00 THEN 'Baseline Purchase'
 WHEN total BETWEEN 2.00 AND 6.99 THEN 'Low Purchase'
 WHEN total BETWEEN 7.00 AND 15.00 THEN 'Target Purchase'
 ELSE 'Top Performer'
 END AS PurchaseType
FROM
 Invoice
WHERE
 PurchaseType = 'Top Performer'
ORDER BY
 InvoiceDate</sql><sql name="SQL 7">SELECT
 *
FROM
 Invoice
INNER JOIN
 Customer
ON
 Invoice.CustomerId = Customer.CustomerId
ORDER BY
 Customer.CustomerId</sql><sql name="SQL 7">SELECT
 c.LastName,
 c.FirstName,
 i.InvoiceId,
 i.CustomerId,
 i.InvoiceDate,
 i.total
FROM
 Invoice AS i
INNER JOIN
 Customer AS c
ON
 i.CustomerId = c.CustomerId
ORDER BY
 c.CustomerId</sql><sql name="SQL 8">-- Description: JOINS on more than two tables | What employees are responsible for the 10 highest individual sales?

SELECT
	e.FirstName,
	e.LastName,
	e.EmployeeId,
	c.FirstName,
	c.LastName,
	c.SupportRepId,
	i.CustomerId,
	i.total
FROM
	Invoice AS i
INNER JOIN
	Customer AS c
ON
	i.CustomerId = c.CustomerId
INNER JOIN
	Employee AS e
ON
	c.SupportRepId = e.EmployeeId
ORDER BY
	i.total DESC
LIMIT 10
</sql><sql name="SQL 5">-- Description: Aggregate Functions | What are our all time global sales?


SELECT
 sum(total) AS [Total Sales],
 round(AVG(total) AS [Average Sales],
 MAX(total) AS [Maximum Sale],
 MIN(total) AS [Minimum Sale],
 COUNT(*) AS [Sales Count]
FROM
 Invoice</sql><sql name="SQL 6">-- Description: Subqueries and DISTINCT | Which tracks are not selling?

SELECT
	TrackId,
	Composer,
	Name
FROM 
	Track
WHERE
	TrackId
NOT IN
(SELECT
	DISTINCT
	TrackId
FROM
	InvoiceLine
ORDER BY 
	TrackId)
</sql><sql name="SQL 7">-- Description: Views


CREATE VIEW V_AvgTotal AS 
SELECT
	round(avg(total), 2) AS [Average Total]
FROM
	Invoice</sql><sql name="SQL 8">-- Description: Views


CREATE VIEW V_AvgTotal AS 
SELECT
	round(avg(total), 2) AS [Average Total]
FROM
	Invoice</sql><sql name="Edit View V_AvgTotal">DROP VIEW IF EXISTS &quot;main&quot;.&quot;V_AvgTotal&quot;;
CREATE VIEW V_AvgTotal AS 
SELECT
	avg(total) AS [Average Total]
FROM
	Invoice</sql><sql name="SQL 10">-- Description: Views and Joins


CREATE VIEW V_Tracks_InvoiceLine AS
SELECT
	il.InvoiceId,
	il.UnitPrice,
	il.Quantity,
	t.Name,
	t.Composer,
	t.Milliseconds
FROM
	InvoiceLine AS il
INNER JOIN
	Track as t
ON
	il.TrackId = t.TrackId</sql><sql name="SQL 11">-- Description: Deleting a Views

DROP VIEW
	V_AvgTotal</sql><sql name="SQL 12">-- Description: DML | Inserting Data

INSERT INTO
	Artist(Name)
VALUES ('Bob Marley')</sql><sql name="SQL 13">-- Description: DML | Updating DATABASE


UPDATE
	Artist
SET
	Name = 'Damian Marley'
WHERE
	ArtistId = 276

SELECT ArtistId	
FROM Artist as a
WHERE a.Name = 'Bob Marley'
</sql><sql name="SQL 14">-- Description: DML | Deleting Data

DELETE FROM
	Artist
WHERE
	ArtistId = 276</sql><sql name="SQL 15">
